CAPI=2:
name: hasunosora:arith:fpadd_pipe:0.2
description: Pipelined Parameterized Precision Floating Point Adder

filesets:
  include:
    files:
      - include/hsf1_macros.svh:
          is_include_file: true
    file_type: systemVerilogSource
  pkg:
    depend:
      - ">=hasunosora:infra:include:0.1a0"
      - ">=hasunosora:infra:typedefs_pkg:0.1a0"
    files:
      - pkg/hsf1_typedef_pkg.sv
    file_type: systemVerilogSource
  rtl:
    depend:
      - ">=hasunosora:infra:include:0.1a0"
      - ">=hasunosora:infra:typedefs_pkg:0.1a0"
      - ">=hasunosora:dpath:skid_buffer:0.1a0"
    files:
      - rtl/alu/hsf1_alu.sv
      - rtl/alu/hsf1_cadder.sv
      - rtl/common/hsf1_grs_lshift.sv
      - rtl/common/hsf1_grs_rshift.sv
      - rtl/common/hsf1_lzc.sv
      - rtl/postproc/hsf1_grs_round.sv
      - rtl/postproc/hsf1_postproc.sv
      - rtl/preproc/hsf1_bvd.sv
      - rtl/preproc/hsf1_preproc.sv
      - rtl/preproc/hsf1_sp_result_gen.sv
      - rtl/hsf1_fpadd_pipe.sv
    file_type: systemVerilogSource
  cocotb_wrapper:
    files:
      - tb/hsf1_cocotb_duv_top.sv
    file_type: systemVerilogSource
  cocotb:
    files:
      - tb/cocotb/hsf1_wrapper_test.py : {file_type: user, copyto: .}
      - tb/cocotb/FloatingPoint.py : {file_type: user, copyto: .}
      - tb/cocotb/FpAdderAgent.py : {file_type: user, copyto: .}
      - tb/cocotb/FpAdderScoreboard.py : {file_type: user, copyto: .}
      - tb/cocotb/FpAdderTestbench.py : {file_type: user, copyto: .}
      - tb/cocotb/FpAdderTransactions.py : {file_type: user, copyto: .}
  sim_script:
    files:
      - tb/script/xrun.tcl: {copyto: xrun_debug.tcl}
    file_type: user

parameters:
  EXPONENT_WIDTH: {datatype: int, paramtype: vlogparam, default: 8}
  MANTISSA_WIDTH: {datatype: int, paramtype: vlogparam, default: 23}
  FP_ROUND_MODE: {datatype: int, paramtype: vlogparam, default: 0}

targets:
  default: &default
    filesets:
      - include
      - pkg
      - rtl
  sim:
    <<: *default
    filesets_append:
      - cocotb_wrapper
      - cocotb
    toplevel: hsf1_cocotb_duv_top
    flow: sim
    parameters: &sim_parameters
      - EXPONENT_WIDTH
      - MANTISSA_WIDTH
      - FP_ROUND_MODE
    flow_options: &xcelium_cocotb
      tool: xcelium
      cocotb_module: hsf1_wrapper_test
      xrun_options:
        - -timescale
        - 1ns/1ps
        - +define+USE_DEFAULT_NETTYPE_WIRE
    description: Cocotb regression with Xcelium
  sim_debug:
    <<: *default
    filesets_append:
      - cocotb_wrapper
      - cocotb
      - sim_script
    toplevel: hsf1_cocotb_duv_top
    flow: sim
    parameters: *sim_parameters
    flow_options:
      <<: *xcelium_cocotb
      xrun_options:
        - -timescale
        - 1ns/1ps
        - +define+USE_DEFAULT_NETTYPE_WIRE
        - -lwdgen
        - -coverage all -covoverwrite -covtest hsf1_fpadd_pipe
    description: Cocotb simulation with waveform and RTL coverage
